{
  "name": "lambda-returns",
  "version": "4.7.7",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    "import": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "imports": {
    "@": "./"
  },
  "repository": "git@github.com:MathRobin/lambda-returns.git",
  "author": "MathRobin <mthrobin@gmail.com>",
  "license": "MIT",
  "sideEffects": false,
  "packageManager": "yarn@4.18.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pkgroll",
    "lint": "eslint -c eslint.config.js",
    "prepare": "husky",
    "prettier": "prettier --check ./",
    "prettier:write": "prettier --write ./",
    "publish": "yarn build && git add dist package.json yarn.lock && yarn npm publish && git commit -m 'feat(version): bump' && git push && git status",
    "test": "vitest run --reporter=verbose --coverage",
    "gen": "yarn tsx src/scripts/res/gen"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "lint-staged": {
    "*.{js,ts}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@types/aws-lambda": "8.10.162"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/eslint-parser": "8.0.1",
    "@babel/plugin-syntax-import-assertions": "7.29.7",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@eslint/js": "10.0.1",
    "@types/babel__core": "7.20.5",
    "@types/lodash-es": "4.17.12",
    "@types/node": "24.13.3",
    "@vitest/coverage-v8": "4.1.11",
    "commitizen": "4.3.2",
    "cz-conventional-changelog": "3.3.0",
    "eslint": "10.9.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.11.0",
    "husky": "9.1.7",
    "lint-staged": "17.3.0",
    "lodash-es": "4.18.1",
    "pkgroll": "2.27.1",
    "prettier": "3.8.4",
    "tsx": "4.22.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.61.1",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "4.1.11"
  }
}
